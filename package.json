    "verify:supabase": "node scripts/verify-supabase.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2"
  }
}
