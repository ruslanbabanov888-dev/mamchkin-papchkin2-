{
  "name": "mamchkin-papchkin-rustore",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Android wrapper for Мамчкин и Папчкин",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "cap:add:android": "cap add android",
